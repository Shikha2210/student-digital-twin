# Data — never commit. See data/README.md for how to obtain OULAD.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/README.md

# The SQLite database is a CACHE of a pipeline run, not a source artefact.
# Regenerate it in two commands rather than committing 30 MB of derived rows:
#   python -m student_twin.store.migrate
#   python scripts/ingest_run.py --students 250 --weeks 20
data/*.db
data/*.db-wal
data/*.db-shm

# Experiment outputs
outputs/
runs/
*.parquet
*.joblib

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/

# Environments
# The project venv lives at the repo root: .venv, Python 3.13.
# Recreate with:  py -3.13 -m venv .venv  &&  .venv\Scripts\python -m pip install -e ".[dev,dashboard]"
# Exact pinned versions are in requirements.lock.txt.
.venv/
venv/
env/

# Claude Code per-machine state. settings.local.json is a local permission
# allowlist carrying absolute paths from whoever generated it. It is local
# state, not project configuration.
.claude/settings.local.json

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml
